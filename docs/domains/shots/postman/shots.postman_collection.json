    {
      "name": "Prompt de edição numerada (aula 011)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{pid}}/shots/scenes/{{scene}}/prompts?kind=edit&edits=Make the helmet visor tinted so the face cannot be seen&edits=Remove the can in the background",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{pid}}", "shots", "scenes", "{{scene}}", "prompts"],
          "query": [
            {"key": "kind", "value": "edit"},
            {"key": "edits", "value": "Make the helmet visor tinted so the face cannot be seen"},
            {"key": "edits", "value": "Remove the can in the background"}
          ]
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('um prompt só (uma rodada por vez)', () => pm.expect(b.prompts).to.have.lengthOf(1));",
        "const t = b.prompts[0].text;",
        "pm.test('instruções numeradas', () => { pm.expect(t).to.include('1. Make the helmet visor tinted'); pm.expect(t).to.include('2. Remove the can in the background'); });",
        "pm.test('fecha com keep everything else identical', () => pm.expect(t).to.have.string('Keep everything else identical, realistic.'));"
      ]}}]
