          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{pid}}", "shots", "scenes", "{{scene}}", "prompts"],
          "query": [
            {"key": "kind", "value": "angle"},
            {"key": "subject", "value": "the astronaut"},
            {"key": "scale", "value": "close"},
            {"key": "realism", "value": "true"},
            {"key": "lens", "value": "35"},
            {"key": "aperture", "value": "2.8"},
            {"key": "angle", "value": "eye-level"}
          ]
        }
      },
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const t = pm.response.json().prompts[0].text;",
        "pm.test('fórmula da aula', () => pm.expect(t).to.include('Bring me another point of view of this image'));",
        "pm.test('foco pedido', () => pm.expect(t).to.include('close-up on the astronaut'));",
        "pm.test('bloco de câmera no lugar do Cinema Studio', () => pm.expect(t).to.include('Shot on RED Komodo 6K, 35mm, f/2.8, close shot, eye-level angle'));"
      ]}}]
    },
    {
      "name": "Prompt de ângulo sem bloco de câmera",
