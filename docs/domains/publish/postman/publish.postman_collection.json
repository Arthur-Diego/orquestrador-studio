			"name": "Portfolio",
			"description": "FDD secao 5, Contrato 6. Gate da decisao 1 do lote: distinct_videos >= 4.",
			"item": [
				{
					"name": "GET portfolio — status do portfolio (gate de 4 videos distintos)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/projects/{{pid}}/publish/portfolio",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"projects",
								"{{pid}}",
								"publish",
								"portfolio"
							]
						},
						"description": "FDD secao 5, Contrato 6 (linha 222). 200 sempre que o projeto existe; nao grava nada.\n\nDECISAO 1 DO LOTE (normativa, FDD linhas 36-40 e 231-232): `ready` e `missing` contam VIDEOS DISTINTOS (`distinct_videos >= 4`), NAO o numero de posts. `goal` = 4.\n`portfolio_md` e null enquanto o log nunca sofreu mutacao."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"let body;",
									"try { body = pm.response.json(); } catch (e) { body = null; }",
									"pm.test('status 200 (FDD s5 C6)', function () { pm.response.to.have.status(200); });",
									"pm.test('schema: count/distinct_videos/goal/ready/missing/portfolio_md', function () {",
									"    pm.expect(body.count, 'count').to.be.a('number');",
									"    pm.expect(body.distinct_videos, 'distinct_videos').to.be.a('number');",
									"    pm.expect(body.goal, 'goal').to.eql(4);",
									"    pm.expect(body.ready, 'ready').to.be.a('boolean');",
									"    pm.expect(body.missing, 'missing').to.be.a('number');",
									"    pm.expect(body).to.have.property('portfolio_md');",
									"    if (body.portfolio_md !== null) {",
									"        pm.expect(body.portfolio_md).to.eql('publish/portfolio.md');",
									"    }",
									"});",
									"pm.test('DECISAO 1 DO LOTE: ready == (distinct_videos >= 4), nao count', function () {",
									"    pm.expect(body.ready).to.eql(body.distinct_videos >= 4);",
									"});",
									"pm.test('DECISAO 1 DO LOTE: missing == max(0, 4 - distinct_videos)', function () {",
									"    pm.expect(body.missing).to.eql(Math.max(0, 4 - body.distinct_videos));",
									"});",
									"pm.test('distinct_videos <= count (mesmo video em 2 redes = 1 video, 2 posts)', function () {",
									"    pm.expect(body.distinct_videos).to.be.at.most(body.count);",
									"});"
								]
							}
						}
					]
				}
			]
