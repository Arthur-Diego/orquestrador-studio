{
  "name": "orquestrador-studio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Frontend do Orquestrador Studio (Wave 10 — migração para React). Build para studio/web/dist/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && ( cd .. && eslint --config eslint.config.js \"studio/etapas/*/ui/**/*.{ts,tsx}\" )",
    "schema:gen": "openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.ts",
    "schema:check": "openapi-typescript openapi.json --default-non-nullable false -o .schema-drift.ts && diff -u src/api/schema.ts .schema-drift.ts && rm -f .schema-drift.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "newman": "^6.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
