%% Etapa 11 (prospect, aula 001) — gate do portfólio: a aula manda publicar 4 vídeos
%% criativos antes de prospectar.
%% ---
%% Fonte de verdade: studio/prospect/service.py (gate, require_gate, REQUIRED_VIDEOS = 4),
%% studio/publish/service.py (global_portfolio, posts_at) e studio/etapas/prospect/router.py
%% (tradução de GateClosed em 409).
%% ---
%% ATENÇÃO (wave 2, ADR-012): o portfólio é GLOBAL e conta PROJETOS DISTINTOS com pelo menos
%% um post registrado — quatro OBRAS, como a aula 015 pede ("pelo menos quatro vídeos… para
%% prática, exposição e validação"). Os três formatos do mesmo comercial (16x9, 9x16, 1x1)
%% contam como 1. Isso substitui a contagem por arquivo dentro do projeto, que deixava a etapa
%% inutilizável: o projeto criado para o negócio do lead nunca terá quatro vídeos publicados.
%% Dentro do projeto, a decisão 1 da wave 1 continua valendo (mesmo arquivo em 2 redes = 1
%% vídeo e 2 posts) — é o campo `videos` de GET /publish/portfolio.
flowchart TD
    A["Requisição em /api/projects/{pid}/prospect/..."] --> B{"Método é GET?"}
    B -->|"sim"| GET["Segue normalmente: GET nunca é bloqueado.<br/>GET /prospect/gate responde 200 sempre, com published,<br/>posts, required, ok, message, projects e this_project_published"]
    B -->|"não: POST, PUT ou DELETE"| C["service.require_gate(root)<br/>→ gate(root) → publish.global_portfolio()"]

    C --> D["Varrer PROJECTS_DIR: cada pasta com project.json"]
    D --> E{"O projeto tem publish/log.json legível<br/>com pelo menos um post?"}
    E -->|"não: ausente, ilegível, inválido ou vazio"| SKIP["Projeto não entra no portfólio<br/>nunca levanta exceção, só registra warning"]
    E -->|"sim"| F["Projeto entra em projects[] com<br/>project_id, name, posts, videos e first_posted"]
    F --> H["publicados = quantidade de PROJETOS distintos com post<br/>4 OBRAS, não 4 arquivos nem 4 entradas de log"]

    SKIP --> I{"publicados &gt;= 4?"}
    H --> I
    I -->|"sim"| OK["gate.ok = true<br/>message: Portfólio pronto, N vídeos publicados. Pode prospectar.<br/>a escrita segue: cadastro, DM, teaser, call e pitch"]
    I -->|"não"| NOK["GateClosed → HTTP 409<br/>detail: A aula manda publicar 4 vídeos criativos antes de<br/>prospectar. Você tem N/4.<br/>nada é escrito em prospect/"]

    OK --> T{"É POST .../leads/{lid}/teaser?"}
    T -->|"sim, e o lead ainda não respondeu"| T422["HTTP 422 — a aula manda criar só depois que a<br/>empresa responder (11.1). Vem ANTES de ffmpeg,<br/>duração, take e trilha"]
    T -->|"sim, e replied = true"| TOK["Segue para os artefatos das etapas 6 e 7"]
    T -->|"não"| OUTRAS["Demais escritas seguem normalmente"]

    classDef passa fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#10331a
    classDef bloqueia fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#3e1010
    classDef leitura fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d2b45
    classDef contagem fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#3e2000
    class GET,OK,TOK,OUTRAS passa
    class NOK,T422 bloqueia
    class A,C,D leitura
    class F,H,SKIP contagem
