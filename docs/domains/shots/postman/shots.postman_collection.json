      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "const b = pm.response.json();",
        "pm.test('base gravada em shots/<cena>/base.png', () => pm.expect(b.base).to.eql(`shots/${pm.variables.get('scene')}/base.png`));",
        "pm.test('origem declarada', () => pm.expect(['storyboard', 'base', 'upload']).to.include(b.source));"
      ]}}]
    },
