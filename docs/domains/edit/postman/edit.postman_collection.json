      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('não recria', () => pm.expect(pm.response.json().created).to.eql(false));"
            ]
          }
        }
      ]
    },
