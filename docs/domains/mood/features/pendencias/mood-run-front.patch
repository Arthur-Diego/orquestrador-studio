+  /** Confirmação da CONTA de downloads (não de custo). Montada sobre o `ui.modal` público, porque
+   * o `_confirmModal` do shell é privado e traz o subtítulo "Custo antes de gerar" — mentira de UI
+   * numa cadeia que não gasta crédito. */
+  function mrnConfirmarDownloads(conta) {
+    return new Promise((resolve) => {
+      let decidido = false;
+      const fim = (v) => { if (decidido) return; decidido = true; resolve(v); };
+      ui.modal({
+        title: "Rodar a cadeia mood_ [extensão]",
+        subtitle: "Downloads de terceiros — sem geração de IA e sem crédito",
+        html: `<p>A corrida vai baixar cerca de <b>${esc(String(conta.downloads))} imagens</b> de terceiros:
