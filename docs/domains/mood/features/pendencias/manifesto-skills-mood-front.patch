+++ b/tests/test_skills_params_front.py
@@ -0,0 +1,81 @@
+"""Auditoria do formulário gerado do manifesto em `studio/web/moodboards.js`.
+
+**Este arquivo faz par com `docs/domains/mood/features/pendencias/manifesto-skills-mood-front.patch`
+e só passa depois que a frente de preparo/shell aplicar aquele patch** — `studio/web/*` é núcleo e
+pertence à frente de shell (ADR-010), então a frente ADH-OS-20260902-04 não pôde entregá-lo.
+Ver §3.1 e §14 de `docs/domains/mood/features/manifesto-skills-mood-fdd.md`.
+
+Testa a tela como texto, sem navegador, no precedente de `tests/test_mood_view.py` (ADR-008).
+"""
+from __future__ import annotations
+
+import re
+
+from studio.moodboards import skills_params as sp
+
+ROTA = "/api/skills/mood/params"
+
+# Os dois únicos literais de manifesto que o front pode conhecer: a regra do
+# `obrigatorio_em_auto` é "quando o parâmetro `gate` vale `auto`".
+LITERAIS_PERMITIDOS = {"gate", "auto"}
+
+
+def _front(client) -> str:
+    r = client.get("/static/moodboards.js")
+    assert r.status_code == 200
+    return r.text
+
+
+def _bloco_do_formulario(client) -> str:
+    """Só o bloco 04 de `moodboards.js` — o resto do arquivo é de outras features."""
+    js = _front(client)
+    inicio = js.index("// ---------- 04 · parâmetros das skills")
+    fim = js.index("// ---------- entrada da área", inicio)
+    return js[inicio:fim]
+
+
+def test_o_front_busca_o_manifesto_e_desenha_o_painel(client):
+    js = _front(client)
+    assert ROTA in js
+    assert "renderSkillsPanel()" in js
+    assert "window.Studio.moodSkillsForm" in js
+
+
+def test_o_front_nao_tem_nenhum_campo_hardcoded(client):
+    """Nenhum nome de parâmetro nem valor de enum aparece como literal no JS.
+
+    É o que garante o critério de aceite "nenhum campo do formulário existe fora do manifesto":
+    se o front citasse um nome, o parâmetro sobreviveria à própria remoção do manifesto.
+    """
+    js = _bloco_do_formulario(client)
+    literais = {p.nome for s in sp.SKILLS for p in s.params}
+    literais |= {o for s in sp.SKILLS for p in s.params for o in p.opcoes}
+    literais |= {p.agregador for s in sp.SKILLS for p in s.params if p.agregador}
+    vazados = sorted(
+        alvo
+        for alvo in literais - LITERAIS_PERMITIDOS
+        if re.search(rf"""["'`]{re.escape(alvo)}["'`]""", js)
+    )
+    assert not vazados, f"o front cita literais do manifesto: {vazados}"
+
+
+def test_o_front_so_envia_o_que_foi_preenchido(client):
+    """A regra "campo vazio não é enviado" precisa estar no código, não só na documentação."""
+    js = _bloco_do_formulario(client)
+    assert "if (!bruto) return;" in js
+    assert "if (marcados.length)" in js
+
+
+def test_o_css_novo_e_escopado_e_inline(client):
+    """ADR-019: `<style>` inline com prefixo próprio; `ui.css` e `style.css` ficam intactos."""
+    js = _front(client)
+    assert "<style>" in js and ".msk-" in js
+    for folha in ("/static/style.css", "/static/ui.css"):
+        r = client.get(folha)
+        assert r.status_code == 200 and ".msk-" not in r.text
+
+
+def test_o_grupo_avancado_nasce_recolhido(client):
+    js = _front(client)
+    assert '<details class="msk-av">' in js
+    assert "<details open" not in js
