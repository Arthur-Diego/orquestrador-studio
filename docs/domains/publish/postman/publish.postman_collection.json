			"name": "Exports",
			"description": "FDD secao 5, Contrato 1. Leitura de `export/*.mp4`.",
			"item": [
				{
					"name": "GET exports — listar export/*.mp4",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/projects/{{pid}}/publish/exports",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"projects",
								"{{pid}}",
								"publish",
								"exports"
							]
						},
						"description": "FDD secao 5, Contrato 1 (linha 136). 200 = lista possivelmente vazia de `export/*.mp4`; 404 = projeto inexistente. `thumb` e null quando `export/thumb.jpg` nao existe."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"let body;",
									"try { body = pm.response.json(); } catch (e) { body = null; }",
									"pm.test('status 200 (FDD s5 C1)', function () { pm.response.to.have.status(200); });",
									"pm.test('schema: {files: [], thumb: string|null}', function () {",
									"    pm.expect(body).to.be.an('object');",
									"    pm.expect(body.files, 'files').to.be.an('array');",
									"    pm.expect(body).to.have.property('thumb');",
									"    if (body.thumb !== null) { pm.expect(body.thumb).to.be.a('string'); }",
									"});",
									"pm.test('cada arquivo tem name/file/size/modified/published', function () {",
									"    (body.files || []).forEach(function (f) {",
									"        pm.expect(f.name, 'name').to.be.a('string');",
									"        pm.expect(f.file, 'file').to.be.a('string').and.to.match(/^export\\//);",
									"        pm.expect(f.size, 'size').to.be.a('number');",
									"        pm.expect(f.modified, 'modified').to.be.a('string');",
									"        pm.expect(f.published, 'published').to.be.a('boolean');",
									"    });",
									"});",
									"pm.test('ordem alfabetica por name (FDD s9)', function () {",
									"    const names = (body.files || []).map(function (f) { return f.name; });",
									"    pm.expect(names).to.deep.equal(names.slice().sort());",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Log",
			"description": "FDD secao 5, Contratos 2 a 5, na ordem dos fluxos da secao 4: ler, registrar (encadeia post_id), dar feedback, remover.",
			"item": [
				{
					"name": "GET log — ler o log de publicacoes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/projects/{{pid}}/publish/log",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"projects",
								"{{pid}}",
								"publish",
								"log"
							]
						},
						"description": "FDD secao 5, Contrato 2 (linha 158). 200 sempre que o projeto existe; log vazio devolve `posts: []`. Log corrompido tambem devolve `posts: []` (FDD s6, linha 279)."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"let body;",
									"try { body = pm.response.json(); } catch (e) { body = null; }",
									"pm.test('status 200 (FDD s5 C2)', function () { pm.response.to.have.status(200); });",
									"pm.test('schema: {posts: [], count: int, goal: 4}', function () {",
									"    pm.expect(body.posts, 'posts').to.be.an('array');",
									"    pm.expect(body.count, 'count').to.be.a('number');",
									"    pm.expect(body.goal, 'goal').to.eql(4);",
									"});",
									"pm.test('invariante count == len(posts) (FDD s6, linha 286)', function () {",
									"    pm.expect(body.count).to.eql(body.posts.length);",
									"});",
									"pm.test('cada post tem os 7 campos do contrato', function () {",
									"    (body.posts || []).forEach(function (p) {",
									"        pm.expect(p.id, 'id').to.be.a('string').and.to.match(/^[0-9a-f]{12}$/);",
									"        pm.expect(p.video, 'video').to.be.a('string');",
									"        pm.expect(p.network, 'network').to.be.a('string');",
									"        pm.expect(p.url, 'url').to.be.a('string').and.to.match(/^https?:\\/\\//);",
									"        pm.expect(p.posted_at, 'posted_at').to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
									"        pm.expect(p.note, 'note').to.be.a('string');",
									"        pm.expect(p.feedback, 'feedback').to.be.a('string');",
									"    });",
									"});",
									"",
									"// DECISAO 1 DO LOTE: o GET log expoe distinct_videos para que ninguem",
									"// avalie count >= goal, que e a leitura proibida pela decisao do lote.",
									"pm.test('DECISAO 1 DO LOTE: log expoe distinct_videos ao lado de count e goal', () => {",
									"    const b = pm.response.json();",
									"    pm.expect(b).to.have.property('distinct_videos');",
									"    pm.expect(b.distinct_videos).to.be.a('number');",
									"    const distintos = new Set(b.posts.map(p => p.video).filter(Boolean)).size;",
									"    pm.expect(b.distinct_videos).to.eql(distintos);",
									"    pm.expect(b.distinct_videos).to.be.at.most(b.count);",
									"});"
								]
							}
						}
					]
				},
