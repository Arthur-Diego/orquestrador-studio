    {
      "name": "PUT timeline com zoom e loudnorm (aula 014: pequenos zooms)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{timelineComZoom}}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/timeline"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tl = JSON.parse(pm.collectionVariables.get('timelineJson') || '{}');",
              "if (tl.clips && tl.clips.length) { tl.clips[0].zoom = 1.15; }",
              "tl.loudnorm = false;",
              "pm.collectionVariables.set('timelineComZoom', JSON.stringify(tl));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const tl = pm.response.json().timeline;",
              "pm.test('zoom preservado', () => pm.expect(tl.clips[0].zoom).to.eql(1.15));",
              "pm.test('loudnorm é [extensão] desligável', () => pm.expect(tl.loudnorm).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT timeline com zoom fora de 1.0–1.3 -> 422",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{timelineZoomInvalido}}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/timeline"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tl = JSON.parse(pm.collectionVariables.get('timelineJson') || '{}');",
              "if (tl.clips && tl.clips.length) { tl.clips[0].zoom = 1.9; }",
              "pm.collectionVariables.set('timelineZoomInvalido', JSON.stringify(tl));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));",
              "pm.test('a mensagem cita o zoom', () => pm.expect(pm.response.json().detail).to.include('zoom'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST propose-cuts (proposta, sem gravar)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"offset\": 0.0, \"black_dur\": 0.2, \"apply\": false}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/propose-cuts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 (404 quando a etapa 7 não gerou beats.json)', () => pm.expect([200, 404]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  pm.test('não grava com apply=false', () => pm.expect(b.applied).to.eql(false));",
              "  pm.test('impacts_used é lista', () => pm.expect(b.impacts_used).to.be.an('array'));",
              "  pm.test('todo quadro preto cai num impacto usado', () => b.timeline.blacks.forEach(bl => pm.expect(b.impacts_used).to.include(bl.at)));",
              "}"
            ]
          }
        }
      ]
    },
