+  /** Desinscrição do contador de escolhidas do painel anterior (o editor repinta a cada `open`). */
+  let mrnUnsub = null;
+
+  /** Total de fotos escolhidas. Usa `Studio.vibes` quando o painel da frente 03 está na página e
+   * cai no próprio endpoint quando não está — os dois leem a MESMA fonte autoritativa. */
+  async function mrnTotalEscolhidas(fallback) {
+    const vibes = window.Studio.vibes;
+    if (vibes && vibes.refreshCount) {
+      try { return await vibes.refreshCount(); } catch (err) { /* o endpoint abaixo decide */ }
+    }
+    try { return (await api("/api/escolhidas?per_page=1")).total; }
+    catch (err) { return fallback || 0; }
+  }
+
+  /** Assina as mudanças da peneira. `Studio.vibes.onChange` quando existe; senão o evento DOM que
+   * a frente 03 dispara — sempre DEPOIS de o estado já estar gravado em disco. */
+  function mrnOnEscolhidasChange(cb) {
+    const vibes = window.Studio.vibes;
+    if (vibes && vibes.onChange) return vibes.onChange(cb);
+    const handler = (ev) => cb((ev.detail && ev.detail.total) || 0);
+    document.addEventListener("studio:escolhidas", handler);
+    return () => document.removeEventListener("studio:escolhidas", handler);
+  }
+
+  function mrnPhotoHtml(item) {
+    const nome = item.arquivo || item.id || "";
+    return `<div class="mrn-ph" data-foto="${esc(item.caminho || "")}" title="${esc(nome)}" tabindex="0" role="button">
+      <img loading="lazy" src="${esc(item.url || "")}" alt="">
+      <span class="mrn-tag">${esc(item.origem || "")}</span></div>`;
+  }
+
+  async function renderMoodRunPanel(st) {
