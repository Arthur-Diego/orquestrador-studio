    {
      "name": "POST render (master) — exige a trilha da etapa 7 (auditoria 8.2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"target\": \"master\"\n}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/render"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const temTrilha = pm.collectionVariables.get('hasMusic') === 'true';",
              "if (temTrilha) {",
              "  pm.test('com trilha: 200 (ou 409 se já houver render em andamento)', () => pm.expect([200, 409]).to.include(pm.response.code));",
              "} else {",
              "  pm.test('sem trilha: 409', () => pm.response.to.have.status(409));",
              "  pm.test('a mensagem manda voltar à etapa 7', () => pm.expect(pm.response.json().detail).to.include('etapa 7'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET guide/edit — o que a aula manda fazer aqui",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{pid}}/guide/edit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const g = pm.response.json();",
              "pm.test('é a etapa 8 da aula 014', () => { pm.expect(g.id).to.eql('edit'); pm.expect(g.n).to.eql(8); pm.expect(g.aula).to.eql('014'); });",
              "pm.test('a trilha é entrada bloqueante', () => pm.expect(g.inputs.map(i => i.id)).to.include('music'));",
              "pm.test('saídas: ritmo primeiro, refinamento depois', () => pm.expect(g.outputs.map(o => o.id)).to.eql(['rough','master']));",
              "pm.test('validação de cortes no ritmo presente', () => pm.expect(g.validations.map(v => v.id)).to.include('cuts_on_beats'));"
            ]
          }
        }
      ]
