    {
      "name": "POST /api/projects/{pid}/base/cost — aditivo: per_item/count/total/raw + CostPreview",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/projects/{{pid}}/base/cost",
        "body": {
          "mode": "raw",
          "raw": "{\"kind\": \"upscale\", \"model\": \"bytedance_image_upscale\", \"count\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 (com CLI) ou 409 (sem CLI) — nunca 500', () => pm.expect([200,409]).to.include(pm.response.code));",
              "if (pm.response.code !== 200) {",
              "  pm.test('409 traz a mensagem de CLI ausente (matriz de erros, seção 6)', () => {",
              "    pm.expect(pm.response.text()).to.match(/CLI|higgsfield/i);",
              "  });",
              "} else {",
              "  const b = pm.response.json();",
              "  pm.test('LEGADO preservado: per_item, count, total, raw', () => {",
              "    ['per_item','count','total','raw'].forEach(k => pm.expect(b, `removeu ${k}`).to.have.property(k));",
              "    pm.expect(b.count).to.be.a('number');",
              "  });",
              "  pm.test('SOMADO: campos do CostPreview', () => {",
              "    ['action','model','label','variant','kind','unit_credits','source','balance','note']",
              "      .forEach(k => pm.expect(b, `falta ${k}`).to.have.property(k));",
              "  });",
              "  pm.test('action veio da KIND_ACTION e existe no catálogo', () => {",
              "    pm.expect(['base.image','base.upscale','base.clean']).to.include(b.action);",
              "  });",
              "  pm.test('source do vocabulário', () => pm.expect(['cli','measured','unknown']).to.include(b.source));",
              "  pm.test('total = unit_credits × count, ou null', () => {",
              "    if (b.unit_credits != null && b.total != null) {",
              "      pm.expect(b.total).to.be.closeTo(b.unit_credits * b.count, 0.01);",
              "    }",
              "  });",
              "  pm.test('balance tem a forma que o widget do chat lê', () => {",
              "    if (b.balance) ['installed','logged_in'].forEach(k => pm.expect(b.balance).to.have.property(k));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
