              ],
              "path": [
                "api",
                "projects",
                "{{pid}}",
                "storyboard",
                "local",
                "job"
              ]
            },
            "description": "FDD motor-local sec.5 (L75). Job local e keyed por pid (unico por projeto) — sem id encadeado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"job -> 200\", function () { pm.response.to.have.status(200); });",
