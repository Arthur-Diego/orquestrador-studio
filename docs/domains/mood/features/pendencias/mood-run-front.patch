+    const boards = r.boards || [];
+    alvo.innerHTML = `
+      <p class="eyebrow" style="margin-top:14px">Última corrida · ${esc(String(r.downloads || 0))} downloads · semente ${esc((r.semente || "").split("/").pop())}</p>
+      <div class="mrn-boards">${boards.map((b) => `
+        <figure class="mrn-board">
+          ${b.prancha_url ? `<a href="${esc(b.prancha_url)}" target="_blank" rel="noopener"><img loading="lazy" src="${esc(b.prancha_url)}" alt=""></a>`
+                          : `<div class="empty">prancha não encontrada no disco</div>`}
+          <figcaption>
+            <b>${esc(b.objetivo || "")}</b> · ${esc(String(b.imagens || 0))} imagens
+            <div class="mrn-docs">
+              ${b.leitura_url ? `<a href="${esc(b.leitura_url)}" target="_blank" rel="noopener">leitura.md</a>` : ""}
+              ${b.curadoria_url ? `<a href="${esc(b.curadoria_url)}" target="_blank" rel="noopener">curadoria.md</a>` : ""}
+            </div>
+          </figcaption>
+        </figure>`).join("")}</div>`;
+  }
