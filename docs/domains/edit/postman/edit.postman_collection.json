    {
      "name": "captions generate (source=script) — itens prontos para a faixa t_cap [extensão]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"source\": \"script\", \"text\": \"Você já parou pra pensar no que sustenta tudo isso hoje\", \"start\": 0.0, \"mode\": \"karaoke\", \"chunk\": 6, \"hi\": \"#C8F751\", \"position\": \"bottom\", \"style\": {\"size\": 34, \"weight\": 700, \"align\": \"center\", \"color\": \"#FFFFFF\", \"bg\": \"transparent\"}}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/captions/generate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('sem OPENAI_API_KEY o tempo é estimado', () => pm.expect(b.source).to.eql('estimate'));",
              "pm.test('word_count = as 11 palavras do roteiro', () => pm.expect(b.word_count).to.eql(11));",
              "pm.test('total_s = palavras / WPS (2.4)', () => pm.expect(b.total_s).to.be.closeTo(11 / 2.4, 0.001));",
              "pm.test('itens no shape de editor.tracks[t_cap].items[]', () => {",
              "  pm.expect(b.items).to.be.an('array').that.is.not.empty;",
              "  const it = b.items[0];",
              "  ['id','start','end','text','mode','hi','chunk','words','style','transform','anim']",
              "    .forEach(k => pm.expect(it).to.have.property(k));",
              "  pm.expect(it.id).to.match(/^cap_[0-9a-f]{6}$/);",
              "  pm.expect(it.mode).to.eql('karaoke');",
              "  pm.expect(it.hi).to.eql('#C8F751');",
              "  pm.expect(it.chunk).to.eql(6);",
              "  pm.expect(it.transform.y).to.eql(0.82);",
              "  pm.expect(it.words[0]).to.have.all.keys('w','start_s','end_s');",
              "});",
              "pm.test('chunk=6 limita a janela a 6 palavras', () => {",
              "  b.items.forEach(it => pm.expect(it.words.length).to.be.at.most(6));",
              "});",
              "pm.test('itens cobrem [0, total_s) sem buraco nem sobreposição', () => {",
              "  pm.expect(b.items[0].start).to.eql(0);",
              "  pm.expect(b.items[b.items.length - 1].end).to.eql(b.total_s);",
              "  b.items.slice(0, -1).forEach((it, i) => pm.expect(it.end).to.eql(b.items[i + 1].start));",
              "});",
              "pm.test('bordas do item são as bordas das suas palavras', () => {",
              "  b.items.forEach(it => {",
              "    pm.expect(it.start).to.eql(it.words[0].start_s);",
              "    pm.expect(it.end).to.eql(it.words[it.words.length - 1].end_s);",
              "  });",
              "});",
              "// evidência do critério cross-feature C <- B: os itens gerados seguem para o PUT /timeline",
              "pm.collectionVariables.set('capItems', JSON.stringify(b.items));",
              "pm.collectionVariables.set('capBody', JSON.stringify(Object.assign(",
              "  JSON.parse(pm.collectionVariables.get('timeline')),",
              "  {editor: {version: 1, tracks: [{id: 't_cap', type: 'caption', name: 'Legendas', items: b.items}]}})));"
            ]
          }
        }
      ]
