              "pm.test('200, 409 ou 404 — nunca 500', () => pm.expect([200,409,404,422]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  pm.test('LEGADO preservado: model, count, per_image, total, source', () => {",
              "    ['model','count','per_image','total','source'].forEach(k => pm.expect(b, `removeu ${k}`).to.have.property(k));",
              "  });",
              "  pm.test('SOMADO: campos do CostPreview', () => {",
              "    ['action','label','variant','kind','unit_credits','balance','note']",
              "      .forEach(k => pm.expect(b, `falta ${k}`).to.have.property(k));",
              "  });",
              "  pm.test('action = mood.multishot', () => pm.expect(b.action).to.eql('mood.multishot'));",
              "  pm.test('source mantém o vocabulário de sempre (sem colisão semântica)', () => {",
              "    pm.expect(['cli','measured','unknown']).to.include(b.source);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/projects/nao-existe/creditos — 404 preservado",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/projects/nao-existe-xyz/creditos"
      },
      "event": [
