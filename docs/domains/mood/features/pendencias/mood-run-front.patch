+    .mrn-ph{position:relative;border-radius:8px;overflow:hidden;cursor:pointer;border:2px solid transparent;aspect-ratio:1}
+    .mrn-ph img{width:100%;height:100%;object-fit:cover;display:block}
+    .mrn-ph.on{border-color:rgba(60,150,90,.95)}
+    .mrn-ph .mrn-tag{position:absolute;left:4px;bottom:4px;font-size:.64rem;background:rgba(0,0,0,.62);color:#fff;padding:1px 5px;border-radius:999px}
+    .mrn-opts{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
+    .mrn-num{width:5.5rem}
+    .mrn-conta{font-size:.82rem;opacity:.82}
