+               <p>Ela <b>não</b> gera imagem com IA e <b>não</b> gasta crédito, mas leva minutos e escreve na pasta do board.</p>`,
+        actions: [
+          { label: "Cancelar", kind: "ghost", onClick: () => fim(false) },
+          { label: `Baixar ~${conta.downloads} e montar`, kind: "primary", onClick: () => fim(true) },
+        ],
+        onClose: () => fim(false),
+      });
+    });
+  }
+
+  /** A barreira: `/estimate` + confirmação explícita ANTES do POST que baixa as imagens. */
+  async function dispararMoodRun(st, base, estado, objetivos, numero) {
+    const corpo = { foto: estado.foto, objetivos, board: numero("#mrnBoard"), n: numero("#mrnN"),
+                    fundo: document.querySelector("#mrnFundo").value || null };
+    let conta;
+    try { conta = await api(`${base}/estimate`, { method: "POST", body: JSON.stringify(
+      { objetivos, board: corpo.board, n: corpo.n }) }); }
+    catch (err) { toast(err.message); return; }
+
+    // `ui.confirmCost` é o modal de GASTO e não serve: esta corrida é gratuita (ADR-016). O que
+    // precisa de confirmação aqui é o volume de downloads de terceiros, não crédito nenhum.
+    const ok = await mrnConfirmarDownloads(conta);
+    if (!ok) return;
+    acompanhar(st, base, () => api(base, { method: "POST", body: JSON.stringify(corpo) }));
+  }
+
+  function acompanhar(st, base, start) {
+    ui.progressJob({
+      title: "Cadeia mood_ [extensão]",
+      subtitle: "vibe → DNA visual → prancha, pelo Claude CLI local",
+      start, jobUrl: `${base}/job`, label: "Pranchas prontas", ms: 3000,
+      done: () => mostrarResultado(st, base),
+    }).catch((err) => toast(err.message));
+  }
+
+  /** Galeria do resultado. `leitura.md`/`curadoria.md` são a revisão humana que o gate auto adiou. */
+  async function mostrarResultado(st, base) {
+    const alvo = document.querySelector("#mrnResult");
+    if (!alvo) return;
+    let r;
+    try { r = await api(`${base}/result`); }
