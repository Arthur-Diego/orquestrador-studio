    {
      "name": "PUT timeline com as legendas geradas (C <- B: generate -> PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{capBody}}"
        },
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/timeline"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const tk = pm.response.json().timeline.editor.tracks.find(t => t.type === 'caption');",
              "pm.test('a faixa de legenda voltou com os itens gravados', () => {",
              "  pm.expect(tk, 'faixa caption').to.be.an('object');",
              "  pm.expect(tk.items).to.have.lengthOf(JSON.parse(pm.collectionVariables.get('capItems')).length);",
              "});",
              "pm.test('words/mode/hi/chunk sobreviveram à gravação', () => {",
              "  const enviado = JSON.parse(pm.collectionVariables.get('capItems'))[0];",
              "  const gravado = tk.items[0];",
              "  pm.expect(gravado.mode).to.eql(enviado.mode);",
              "  pm.expect(gravado.hi).to.eql(enviado.hi);",
              "  pm.expect(gravado.chunk).to.eql(enviado.chunk);",
              "  pm.expect(gravado.words).to.eql(enviado.words);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET timeline depois do PUT (C <- B: round-trip de words/mode/hi/chunk)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/timeline"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const enviados = JSON.parse(pm.collectionVariables.get('capItems'));",
              "const tk = pm.response.json().timeline.editor.tracks.find(t => t.type === 'caption');",
              "pm.test('a legenda gerada está no timeline.json relido', () => {",
              "  pm.expect(tk, 'faixa caption').to.be.an('object');",
              "  pm.expect(tk.items).to.have.lengthOf(enviados.length);",
              "});",
              "pm.test('os quatro campos novos batem item a item', () => {",
              "  tk.items.forEach((it, i) => {",
              "    pm.expect(it.mode, `item ${i} mode`).to.eql(enviados[i].mode);",
              "    pm.expect(it.hi, `item ${i} hi`).to.eql(enviados[i].hi);",
              "    pm.expect(it.chunk, `item ${i} chunk`).to.eql(enviados[i].chunk);",
              "    pm.expect(it.words, `item ${i} words`).to.eql(enviados[i].words);",
              "    pm.expect(it.text, `item ${i} text`).to.eql(enviados[i].text);",
              "  });",
              "});",
              "pm.test('o backbone da aula 014 continua intacto', () => {",
              "  const tl = pm.response.json().timeline;",
              "  pm.expect(tl.clips).to.be.an('array');",
              "  pm.expect(tl.music).to.have.property('offset');",
              "  pm.expect(tl.fade_out).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
