{
  "info": {
    "name": "Orquestrador Studio — edit (etapa 8, aula 014)",
    "description": "Contratos públicos da seção 5 do FDD `docs/domains/edit/features/edit-fdd.md`. O projeto apontado por {{pid}} precisa ter os artefatos das etapas 5, 6 e 7 (shots/storyboard.json, animate/takes.json, audio/music.* e audio/beats.json). Wave 2 (OS-018): `zoom` por clipe e `loudnorm` na timeline, `black_dur` default 0 na proposta de cortes, master exige a trilha da etapa 7 (409) e o guia da etapa (`/api/projects/{pid}/guide/edit`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8765"
    },
    {
      "key": "pid",
      "value": "2026-08-gelo-zero"
    }
  ],
  "item": [
    {
      "name": "ffmpeg disponível (chip da UI)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/edit/ffmpeg"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('available booleano', () => pm.expect(pm.response.json().available).to.be.a('boolean'));",
              "pm.collectionVariables.set('ffmpeg', pm.response.json().available);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET timeline (cria a inicial na primeira chamada)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{pid}}/edit/timeline"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('created é booleano', () => pm.expect(b.created).to.be.a('boolean'));",
              "pm.test('duration numérica', () => pm.expect(b.duration).to.be.a('number'));",
              "pm.test('clips com o schema da wave', () => {",
              "  pm.expect(b.timeline.clips).to.be.an('array').that.is.not.empty;",
              "  const c = b.timeline.clips[0];",
              "  ['scene','shot','take','file','in','out','speed','blend'].forEach(k => pm.expect(c).to.have.property(k));",
              "});",
              "pm.test('music, blacks, sfx e fade_out presentes', () => {",
              "  pm.expect(b.timeline.music).to.have.property('offset');",
              "  pm.expect(b.timeline.blacks).to.be.an('array');",
              "  pm.expect(b.timeline.sfx).to.be.an('array');",
              "  pm.expect(b.timeline.fade_out).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('timeline', JSON.stringify({clips: b.timeline.clips.map(({duration, ...c}) => c), blacks: b.timeline.blacks, music: b.timeline.music, sfx: b.timeline.sfx, fade_out: b.timeline.fade_out}));",
              "pm.collectionVariables.set('hasMusic', String(!!(pm.response.json().timeline.music || {}).file));",
              "pm.collectionVariables.set('timelineJson', JSON.stringify(pm.response.json().timeline));"
            ]
          }
        }
      ]
    },
