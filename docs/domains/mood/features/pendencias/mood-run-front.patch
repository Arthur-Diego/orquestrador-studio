+    const btn = document.querySelector("#btnMrnRun");
+    const chipClaude = document.querySelector("#mrnClaude");
+    const chipEsc = document.querySelector("#mrnEscolhidas");
+    const elFotos = document.querySelector("#mrnFotos");
